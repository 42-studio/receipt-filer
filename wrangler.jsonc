{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "receipt-filer",
  "main": "src/index.ts",
  // The UI is served only on the custom domain, behind Cloudflare Access.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "receipts.42.studio", "custom_domain": true }],
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  // Local dev only: wrangler dev answers ctx.access.getIdentity() with this person. Copy .dev.vars.example to .dev.vars for dev.
  "access": { "dev": { "aud": "dev", "identity": { "email": "owner@example.com" } } },
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "receipt-filer",
      "database_id": "6b366404-c13a-4c62-b7a2-fb325e75f6b9",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "receipt-filer-files" }],
  "ai": { "binding": "AI" },
  "images": { "binding": "IMAGES" },
  "send_email": [{ "name": "EMAIL" }],
  // FORWARD_ADDRESS, ALLOWED_SENDERS, NOTIFY_TO and OWNER_EMAIL are Worker secrets (wrangler secret put), never vars.
  "vars": {
    "FREEAGENT_BASE_URL": "https://api.freeagent.com/v2",
    "CLAIRIC_MODEL": "@cf/cloudflare/clairic",
    "APP_URL": "https://receipts.42.studio"
  }
}
