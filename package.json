{
  "name": "receipt-filer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && npm --prefix ui run typecheck",
    "test": "vitest run",
    "dev:ui": "node dev/start.mjs",
    "build": "npm --prefix ui run build",
    "pretest": "test -d ui/dist || npm run build",
    "dev:worker": "npm run build && wrangler d1 migrations apply DB --local -c dev/wrangler.jsonc --persist-to .wrangler/dev-ui && wrangler dev -c dev/wrangler.jsonc --persist-to .wrangler/dev-ui --port 8788"
  },
  "dependencies": {
    "hono": "^4.13.18",
    "postal-mime": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^5.20261115.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
